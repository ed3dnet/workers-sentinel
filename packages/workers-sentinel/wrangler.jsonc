{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "workers-sentinel",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-18",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	// Production: custom domain only; the workers.dev subdomain stays off.
	// Custom-domain routes are deploy-time declarations — inert under
	// `wrangler dev --local`.
	"workers_dev": false,
	"routes": [
		{
			"pattern": "wat.tilmonengineering.com",
			"custom_domain": true
		}
	],
	"build": {
		"command": "cd ../dashboard && npm run build"
	},
	"vars": {
		"FEEDBACK_DSN": "https://8b4c3e3d981e37fa1fbe70a8dfe8d9ac@wat.tilmonengineering.com/653a8a0a-a93b-4901-887b-3a751218fe6a"
	},
	// Attachment blob storage (metadata rows stay in ProjectState). Miniflare
	// (`wrangler dev`, vitest-pool-workers, the integration runner) simulates
	// this bucket from the binding; the production bucket is created at deploy
	// time with `wrangler r2 bucket create sentinel-attachments`.
	"r2_buckets": [
		{
			"binding": "ATTACHMENTS",
			"bucket_name": "sentinel-attachments",
			"preview_bucket_name": "sentinel-attachments"
		}
	],
	// Durable Object bindings
	"durable_objects": {
		"bindings": [
			{
				"name": "AUTH_STATE",
				"class_name": "AuthState"
			},
			{
				"name": "PROJECT_STATE",
				"class_name": "ProjectState"
			}
		]
	},
	// Migrations for SQLite-backed Durable Objects
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["AuthState", "ProjectState"]
		}
	],
	// Serve dashboard static assets
	"assets": {
		"directory": "../dashboard/dist",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	}
}
