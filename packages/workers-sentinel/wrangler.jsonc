{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "workers-sentinel",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-18",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	// Production: custom domain only; the workers.dev subdomain stays off.
	// Custom-domain routes are deploy-time declarations — inert under
	// `wrangler dev --local`.
	"workers_dev": false,
	"routes": [
		{
			"pattern": "aw-heck.ed3d.net",
			"custom_domain": true
		}
	],
	"build": {
		"command": "cd ../dashboard && npm run build"
	},
	// Durable Object bindings
	"durable_objects": {
		"bindings": [
			{
				"name": "AUTH_STATE",
				"class_name": "AuthState"
			},
			{
				"name": "PROJECT_STATE",
				"class_name": "ProjectState"
			}
		]
	},
	// Migrations for SQLite-backed Durable Objects
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["AuthState", "ProjectState"]
		}
	],
	// Serve dashboard static assets
	"assets": {
		"directory": "../dashboard/dist",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	}
}
